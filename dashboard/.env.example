# ── AATS Sniper dashboard (frontend) ───────────────────────────
# The operator deck runs STANDALONE on mock data by default — no backend
# needed for `npm run dev`. Flip to "false" only when a control plane is up.
VITE_USE_MOCK=true

# Operator control-plane base URL. Used only when VITE_USE_MOCK=false; the
# typed client (src/lib/api.ts) then fetches/streams /api/* against it.
VITE_CONTROL_PLANE_URL=http://localhost:8787

# ── Backend (only needed when running the legacy tRPC/MySQL control plane) ──
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
