# ── AATS Sniper dashboard (frontend) ───────────────────────────
# STANDALONE (npm run dev / npm run build): runs on SYNTHETIC mock data by
# default — no backend needed. This file keeps the standalone default = mock.
#   (Data source in mock mode is src/lib/mock.ts — clearly labeled SYNTHETIC,
#    NOT real edge data.)
# Flip to "false" only when a control plane is up.
#
# DOCKER (`docker compose up`): the dashboard IMAGE builds LIVE by default
# (VITE_USE_MOCK=false, VITE_CONTROL_PLANE_URL=http://localhost:8787) — see
# docker/Dockerfile.dashboard and docker-compose.yml build.args. The browser
# reaches the host-mapped control-plane at port 8787. This file does NOT affect
# the docker build (Vite only reads .env at build time inside the image, where
# the build args set these instead).
VITE_USE_MOCK=true

# Operator control-plane base URL. Used only when VITE_USE_MOCK=false; the
# typed client (src/lib/api.ts) then fetches/streams /api/* against it.
# For the docker/compose LIVE build this is the HOST-mapped port (8787), because
# the static UI runs in the operator's browser on the host — not inside the
# bridge network — so it cannot use the service name aats-controlplane.
VITE_CONTROL_PLANE_URL=http://localhost:8787

# ── Backend (only needed when running the legacy tRPC/MySQL control plane) ──
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
