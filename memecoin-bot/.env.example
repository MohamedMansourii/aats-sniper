# Copy to .env and fill in. NEVER commit a real .env. Keys here can move funds.

# --- Wallet keys (ONLY needed for live trading, which is not implemented) ---
SOLANA_PRIVATE_KEY=""
BASE_PRIVATE_KEY=""

# --- RPC endpoints ---
RPC_SOLANA_WS="wss://api.mainnet-beta.solana.com"
RPC_BASE_HTTP="https://mainnet.base.org"

# --- Premium / low-latency infra (optional) ---
DEEZNODE_URL=""
JITO_AUTH_TOKEN=""
BLOXROUTE_API_KEY=""

# --- APIs ---
JUPITER_API="https://quote-api.jup.ag/v6"
RUGCHECK_API="https://api.rugcheck.xyz/v1"
TELEGRAM_BOT_TOKEN=""
TWITTER_BEARER_TOKEN=""

# --- Database (leave DB_HOST blank to use the in-memory store) ---
DB_HOST=""
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="trading_bot"

# --- Dashboard control endpoints (POST /api/control/start|stop) ---
DASHBOARD_PASSWORD=""
