# AATS — dashboard service Dockerfile
# Builds the React/Vite operator UI and serves it as static files.
#
# DEFAULT FOR THIS IMAGE = LIVE control plane (not mock):
#   VITE_USE_MOCK=false
#   VITE_CONTROL_PLANE_URL=http://localhost:8787
# Rationale: `docker compose up` must hand the operator a LIVE deck wired to the
# host-mapped control-plane (8787 is the host-published port — the browser, which
# runs on the host, reaches the API there, NOT at the in-network service name).
# Both build args are overridable via --build-arg / docker-compose build.args.
#
# The npm/standalone default stays MOCK and is UNAFFECTED by this file: `npm run
# dev`/`npm run build` with no env set resolves USE_MOCK=true in src/lib/api.ts
# (VITE_USE_MOCK !== "false"). Only this container build opts into live.
#
# NFR-011 / AC-049: dashboard MUST build green — the live build is verified green
# (paper-only: DRY_RUN default true server-side; the operator surface is de-risk
# only and cannot enable real capital). This image enforces a green build.

# ── Stage 1: Node build ────────────────────────────────────────────────────
FROM node:20.14.0-slim AS node-builder

WORKDIR /app

# Copy package files first for layer caching
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --ignore-scripts

# Copy source
COPY dashboard/ ./

# Build LIVE by default for this image — wired to the host-mapped control plane.
# Both args are overridable at build time via --build-arg (compose passes them).
#   VITE_USE_MOCK=false              → src/lib/api.ts USE_MOCK resolves false
#   VITE_CONTROL_PLANE_URL=...:8787  → browser (on host) reaches the published API
ARG VITE_USE_MOCK=false
ARG VITE_CONTROL_PLANE_URL=http://localhost:8787
ENV VITE_USE_MOCK=${VITE_USE_MOCK}
ENV VITE_CONTROL_PLANE_URL=${VITE_CONTROL_PLANE_URL}

RUN npm run build

# ── Stage 2: nginx static serve ───────────────────────────────────────────
FROM nginx:1.27.0-alpine AS runtime

LABEL org.opencontainers.image.title="aats-dashboard"
LABEL org.opencontainers.image.description="AATS operator dashboard (Vite static, served via nginx)"

# vite.config.ts sets outDir: "dist/public" — copy that subdirectory as the
# nginx root so index.html lands at /usr/share/nginx/html/index.html.
COPY --from=node-builder /app/dist/public /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
