# AATS — aats-telegram service Dockerfile
# Runs the Telegram alert + constrained de-risk command channel (Lane F, T-360/T-361).
#
# Commands exposed: /status /kill /flatten[mint] /pause — DE-RISK ONLY.
# Authorization: operator user-ID allowlist (OQ-004) + bot-token Vault ref (§5.4).
# No risk-increase command is reachable from Telegram (api-contracts.md §10).
#
# No secrets in this file. Bot token is a Vault reference; see .env.example.

FROM python:3.11.9-slim@sha256:7b09a3b7ccb95df60a78c4d2b0e52fc78d4e64fe9a9fddb0f9a0ea50d7cd8d9a AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/requirements.txt /build/requirements.txt
RUN pip install --no-cache-dir --prefix=/install -r /build/requirements.txt

FROM python:3.11.9-slim@sha256:7b09a3b7ccb95df60a78c4d2b0e52fc78d4e64fe9a9fddb0f9a0ea50d7cd8d9a AS runtime

LABEL org.opencontainers.image.title="aats-telegram"
LABEL org.opencontainers.image.description="AATS Telegram alert + de-risk commands (Lane F)"

WORKDIR /app
COPY --from=builder /install /usr/local
COPY aats/ /app/aats/
COPY pyproject.toml /app/pyproject.toml

RUN adduser --disabled-password --gecos "" --uid 1000 aats
USER aats

ENV DRY_RUN_ENABLED=true
ENV PYTHONUNBUFFERED=1
ENV METRICS_PORT=9104
EXPOSE 9104

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:9104/health')" || exit 1

# Real bot entrypoint wired in T-360/T-361
CMD ["python", "-m", "aats.telegram_bot"]
