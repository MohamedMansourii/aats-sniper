# ============================================================
# AATS .env.example  —  ENVIRONMENT SCHEMA ONLY (NO REAL VALUES)
# ============================================================
# This file is the ONLY place the environment schema is documented.
# REAL VALUES ARE NEVER COMMITTED. Real values are CEO-provided at deploy
# time (charter §3.7; BUILD-DIRECTIVE HARD RULES; infrastructure.md §9).
#
# Owner: crypto-security-engineer (T-251). Companion: custody-policy.md.
#
# ─────────────────────────────────────────────────────────────────────
# HARD RULE — FORBIDDEN: the raw wallet private key NEVER appears here,
# in any other env var, in code, in a log, or in a Docker layer.
#   * There is NO  WALLET_PRIVATE_KEY / WALLET_SECRET_KEY / KEYPAIR_JSON
#     variable in this schema BY DESIGN (ADR-0009 §5.3 removed it).
#   * An env-injected raw key would land in /proc/<pid>/environ, core
#     dumps, and any os.environ dump — that path is FORBIDDEN.
#   * The wallet SECRET is fetched ONLY by aats-signer, from Vault, via a
#     short-lived token at boot, held in mlock-able memory, zeroized on
#     exit. The hot core holds the PUBKEY only.
# crypto-security-engineer audits this at G4 (T-403).
# ─────────────────────────────────────────────────────────────────────

# ── Capital-staging mode (the DRY-RUN hard constraint) ─────────────────
# DEFAULT = true. Real capital DISABLED by default (BUILD-DIRECTIVE HARD RULE).
# Set false ONLY after CEO explicitly authorizes R3, edge is proven on
# recorded data, AND a CEO auth token is presented to POST /api/mode LIVE.
DRY_RUN_ENABLED=true

# Agent mode on startup (SHADOW | PAPER | LIVE_DRY_RUN | LIVE) — api-contracts §2.
AATS_MODE=SHADOW

# Environment label (sim | devnet | mainnet-shadow | mainnet-paper | mainnet-live).
AATS_ENV=sim

# ── Vault (secret management — the ONLY source of key material) ─────────
VAULT_ADDR=https://vault.example.com
# Short-lived Vault token presented at boot by aats-signer. This is a TOKEN
# (a capability with a short TTL), NEVER the key. The signer exchanges it for
# the wallet secret, holds it in mlock-able memory, and zeroizes on exit.
# Prefer AppRole/Kubernetes-auth so even this token is not a static secret.
VAULT_TOKEN=<short-lived-vault-token>

# ── Wallet (trade-only, CAPPED, non-custodial hot wallet — NEVER main holdings) ──
# PUBKEY ONLY. Used by aats-hotcore to build unsigned transactions.
# The SECRET is fetched by aats-signer from Vault (NEVER via any env var — see banner).
WALLET_PUBKEY=<solana-pubkey>
# Vault path where the wallet secret lives (aats-signer reads it at boot). Path, not key.
WALLET_SECRET_VAULT_PATH=secret/aats/trade-wallet
# Operator-set hard balance cap for the trade-only wallet (lamports; <= 2 SOL at R3).
# Bounds blast radius to the float. Top up out-of-band from cold storage.
WALLET_MAX_BALANCE_LAMPORTS=2000000000

# ── Signer (aats-signer) socket + policy ───────────────────────────────
# Loopback Unix-domain socket the hot core / DMS call sign() on. NO inbound network.
SIGNER_SOCKET_PATH=/run/aats/signer.sock
# Path to the program-ID allowlist + tip-account pin the signer enforces.
SIGNER_ALLOWLIST_PATH=/app/config/program-allowlist.json
# Velocity cap: max sign() calls per rolling window (defense-in-depth, infrastructure.md §5.2.1).
SIGNER_MAX_SIGNS_PER_WINDOW=20
SIGNER_WINDOW_SECONDS=60

# ── RPC / Geyser endpoints ─────────────────────────────────────────────
# Premium RPC + Geyser (Helius / Triton / QuickNode). The api-key here is a PLACEHOLDER.
RPC_PRIMARY=https://mainnet.helius-rpc.com/?api-key=<key>
RPC_SECONDARY=https://api.mainnet-beta.solana.com
GEYSER_ENDPOINT=https://atlas-mainnet.helius-rpc.com:2053
GEYSER_TOKEN=<geyser-api-key>

# ── Free-tier WS fallback (--source=ws, EnhancedWsFallback) ───────────────
# Standard Solana logsSubscribe WebSocket endpoint. Works on a free Helius key.
# If unset, derived automatically from RPC_PRIMARY by replacing https:// → wss://.
# For Helius: wss://mainnet.helius-rpc.com/?api-key=<key>  (same key as RPC_PRIMARY)
# Leave blank to let the transport derive the URL from RPC_PRIMARY automatically.
# NEVER hardcode the key here — inject at deploy time.
WS_ENDPOINT=
# ShredStream overlay (optional; empty disables).
SHREDSTREAM_ENDPOINT=
SHREDSTREAM_TOKEN=

# ── Jito ───────────────────────────────────────────────────────────────
JITO_BLOCK_ENGINE=https://frankfurt.mainnet.block-engine.jito.wtf
JITO_TIP_FLOOR_URL=https://bundles-api-rest.jito.wtf/api/v1/bundles/tip_floor
JITO_TIP_STREAM_WS=wss://bundles.jito.wtf/api/v1/bundles/tip_stream

# ── Infra tier (infrastructure.md §4, OQ-003): dedicated_geyser | colo_shred ──
INFRA_TIER=dedicated_geyser

# ── Dead-man's switch (OQ-006) ─────────────────────────────────────────
T_DMS_SECONDS=60

# ── Risk-config FLOORS (signer enforces these independently — §5.2.1) ──
PER_TRADE_CAP_LAMPORTS=100000000     # 0.1 SOL — per-tx signer cap
MAX_AGGREGATE_LAMPORTS=500000000     # 0.5 SOL — rolling-window signer cap
DAILY_LOSS_LIMIT_SOL=-0.30           # absolute -0.30 SOL floor (OQ-001)

# ── Control plane ──────────────────────────────────────────────────────
# CEO auth token required for POST /api/mode LIVE (AC-060). PLACEHOLDER — set at R3 only.
CEO_AUTH_TOKEN=<operator-sets-this-at-R3>

# ── Telegram operator channel (api-contracts §10; infrastructure.md §5.4) ──
# Bot token is a VAULT REFERENCE (path), never the token itself — a leaked bot
# token must not be able to drive the de-risk channel (§5.4).
TELEGRAM_BOT_TOKEN_VAULT_REF=secret/aats/telegram-bot-token
# SINGLE operator user-ID allowlist (OQ-004, AC-043). Necessary, NOT sufficient:
# /kill and /flatten still require a per-command confirm (custody-policy.md §Telegram).
# Comma/space-separated; placeholder => empty allowlist => NO command authorized (fail-closed).
TELEGRAM_OPERATOR_USER_IDS=<your-telegram-user-id>
# T-361 command bot → control-plane POSTs. The Bearer operator token the command
# bot presents on /api/kill /api/flatten /api/mode (de-risk only). VAULT REF /
# runtime-injected — NEVER the token itself; placeholder => offline (no real call).
OPERATOR_API_TOKEN=<vault-ref: secret/aats/operator-api-token>
# Base URL the Telegram command bot routes de-risk commands to (control plane).
CONTROL_PLANE_URL=http://localhost:8787
# Alert bot (Alertmanager) — SEPARATE from the operator command bot. Vault ref preferred.
ALERTMANAGER_TELEGRAM_BOT_TOKEN=<alertmanager-bot-token-or-vault-ref>
ALERTMANAGER_TELEGRAM_CHAT_ID=<your-chat-id>
ALERTMANAGER_PAGERDUTY_KEY=

# ── Social / enrichment APIs (SLOW loop only; adversarial input) ───────
# Provider keys are Vault refs or runtime-injected; PLACEHOLDERS here.
OPENAI_API_KEY=<vault-ref-or-runtime-injected>
SOCIAL_API_KEY=<lunarcrush-or-similar-key>
BIRDEYE_API_KEY=<birdeye-key>
DEXSCREENER_API_KEY=

# MCS sentiment pipeline (T-306 — SLOW LOOP ONLY; never on SNIPE hot path)
# X (Twitter) API v2 — Bearer token for recent search endpoint.
# Basic tier minimum. Rate: 1,500,000 tweets/month. NEVER commit real token.
X_API_BEARER_TOKEN=<vault-ref: secret/aats/x-api-bearer-token>
# Reddit asyncpraw credentials for read-only search (r/SolanaMemeCoins etc.)
REDDIT_CLIENT_ID=<vault-ref: secret/aats/reddit-client-id>
REDDIT_CLIENT_SECRET=<vault-ref: secret/aats/reddit-client-secret>
REDDIT_USER_AGENT=aats-mcs-sentiment/0.1
# Telegram MTProto API credentials for channel monitoring (telethon)
TELEGRAM_MTProto_API_ID=<vault-ref: secret/aats/telegram-mtproto-api-id>
TELEGRAM_MTProto_API_HASH=<vault-ref: secret/aats/telegram-mtproto-api-hash>
TELEGRAM_MTProto_SESSION=<vault-ref: secret/aats/telegram-mtproto-session>
# Comma-separated list of Telegram channel IDs to monitor
MCS_TELEGRAM_CHANNEL_IDS=

# ── LLM Reasoner router (T-313 — SLOW LOOP ONLY; never on SNIPE/FAST hot path) ──
# The de-risk-only Reasoner adjudicates quant-prob vs MCS and emits a de-risk verdict.
# DEFAULT is the deterministic OFFLINE mock backend (zero network); the live backends
# below are OPT-IN plug-in points (router.build_ollama_backend / build_frontier_backend).
# NEVER commit a real key; these are Vault refs / runtime-injected placeholders.
# Local Ollama (DeepSeek / Kimi) for routine, well-separated cases:
AATS_OLLAMA_URL=<e.g. http://ollama:11434/v1 — runtime-injected, not committed>
# Frontier escalation (ambiguous / high-stakes calls only) via instructor:
AATS_FRONTIER_API_KEY=<vault-ref: secret/aats/frontier-llm-api-key>

# ── Dashboard ──────────────────────────────────────────────────────────
VITE_USE_MOCK=true
VITE_CONTROL_PLANE_URL=http://localhost:8787

# ── Grafana ────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<set-at-deploy>

# ── Execution venue (T-327, solana-execution-engineer) ─────────────────
# Jupiter v6 API base URL (for FAST-path exits / Jupiter-routed swaps).
# The snipe BUY uses direct-AMM, NOT Jupiter (FR-028, AC-018).
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Default Jito tip in lamports — the MEV engineer's tip cache overrides this
# at runtime (FR-027). This is the fallback for offline / DRY_RUN mode only.
# NEVER hardcode a value here for LIVE — it must come from the live tip_stream.
JITO_DEFAULT_TIP_LAMPORTS=200000

# Default CU price in micro-lamports — overridden by dynamic CU estimator.
DEFAULT_CU_PRICE_MICROLAMPORTS=100000

# Max retry attempts for blockhash-expiry / node-lag transient failures.
# Each retry fetches a fresh blockhash (tenacity, resilient submit, T-327).
LAND_MAX_ATTEMPTS=3

# ── Multi-wallet / bundle execution (T-328, solana-execution-engineer) ─────
# N_max = 1 at R3 (OQ-010). Multi-wallet is BUILT+TESTED but NOT ACTIVATED
# until R4 (net-of-cost PnL + model-vs-baseline proven on recorded data).
# N_WALLETS_MAX_ENABLED must be explicitly set to "true" to allow N > 1.
N_WALLETS_MAX_ENABLED=false
# Number of signing wallet slots (1..5). Capped by N_WALLETS_MAX_HARD_CEILING=5.
# At R3, must be 1. Ignored unless N_WALLETS_MAX_ENABLED=true.
N_WALLETS_MAX=1
# Anti-cluster blast-radius cap: total SOL across ALL wallets to a SINGLE mint.
# Must be <= PER_TRADE_CAP_LAMPORTS (custody-policy.md §1: C = per_trade_cap).
# Default 0.1 SOL. Integer lamports. No float.
MULTI_WALLET_MINT_CAP_LAMPORTS=100000000

# ── Sell-sim honeypot probe (T-329, solana-execution-engineer) ──────────
# Max effective sell-tax in bps above which a token is flagged as a honeypot.
# Default 1000 bps (10%). Tighten-only (smaller = more conservative).
SELL_SIM_MAX_SELL_TAX_BPS=1000
# Minimum output ratio in bps (of fair quote) the simulated sell must return.
# Default 5000 bps (50%). Tighten-only.
SELL_SIM_MIN_OUT_RATIO_BPS=5000
# Dust sell amount in token base units. Default 1 (smallest non-zero sell).
# Used to probe the token-transfer mechanics without market impact.
SELL_SIM_DUST_AMOUNT=1

# ============================================================
# E4 — CONTROL-PLANE EXPOSURE HARDENING (appended block; placeholders only)
# ============================================================
# The control plane carries the destructive de-risk surface (/api/kill,
# /api/flatten, /api/mode, /api/breaker/reset). Two independent controls:
#   (1) operator bearer token on every POST  -> OPERATOR_API_TOKEN above.
#   (2) loopback-by-default network exposure  -> the vars below.
#
# BIND HOST: default 127.0.0.1 (loopback only). NEVER 0.0.0.0 by default.
# Setting a non-loopback value is OPT-IN and logs a SECURITY warning; it is
# acceptable ONLY behind the documented nginx reverse proxy (TLS + IP allowlist,
# deploy/nginx/aats-controlplane.conf) on an isolated network. Leave unset for
# the secure default.
CONTROL_PLANE_BIND_HOST=127.0.0.1
CONTROL_PLANE_BIND_PORT=8787

# Operator bearer token the control plane REQUIRES on every destructive POST
# (server.py:_check_operator_auth reads OPERATOR_TOKEN). Vault ref / runtime-
# injected — NEVER the token itself. Placeholder => offline; dashboard/Telegram
# must present this exact token. (Mirror of OPERATOR_API_TOKEN for the API side.)
OPERATOR_TOKEN=<vault-ref: secret/aats/operator-api-token>
# CEO auth token presented to POST /api/mode LIVE (X-CEO-Auth header, AC-060).
# Separate from the operator token; placeholder => LIVE unreachable. Set at R3 only.
CEO_TOKEN=<operator-sets-this-at-R3>

# ============================================================
# E1 — DEVNET LIVE-SEND VALIDATION MODE (appended block; placeholders only)
# ============================================================
# Owner: solana-execution-engineer (E1 enhancement directive)
#
# PURPOSE: adds a DEVNET execution target that ACTUALLY SUBMITS + confirms
# on Solana DEVNET (worthless SOL, separate cluster from mainnet), exercising
# the real submit→land→confirm→reconcile path without touching real capital.
#
# CLUSTER SWITCH:
#   SOLANA_CLUSTER=devnet   — enables DEVNET submit mode (SubmitMode.DEVNET).
#   SOLANA_CLUSTER=mainnet  — normal path (DRY_RUN by default, LIVE when gated).
#   absent                  — safe default: mainnet path → DRY_RUN.
#
# SAFETY INVARIANTS (unchanged by E1):
#   • DRY_RUN is still the DEFAULT — absent SOLANA_CLUSTER → DRY_RUN, NO submit.
#   • Mainnet LIVE still hard-gated behind DRY_RUN_ENABLED=false + CEO auth.
#   • Devnet is a SEPARATE cluster: SubmitMode.DEVNET != SubmitMode.LIVE.
#   • The safety primitives (circuit breaker / survivable stop / DMS) sit above
#     M4 and are UNAFFECTED by this change.
#   • No real capital — devnet SOL has NO monetary value and is on a separate net.
#   • No secrets committed here (placeholders only — real values are CEO-provided).
#
# Cluster identifier — controls which Solana cluster the venue targets.
# Values: devnet | mainnet (default: mainnet → DRY_RUN)
SOLANA_CLUSTER=mainnet

# Solana DEVNET RPC endpoint URL.
# Required for DEVNET submit mode (SOLANA_CLUSTER=devnet).
# The public endpoint is rate-limited; use a premium devnet RPC for E1 validation.
# PUBLIC (rate-limited, no key required):  https://api.devnet.solana.com
# Premium (Helius devnet):                https://devnet.helius-rpc.com/?api-key=<key>
# Placeholder: blank = DevnetSubmitBlocked raised if cluster=devnet is attempted.
RPC_DEVNET=<devnet-rpc-url-e.g. https://api.devnet.solana.com>

# Devnet airdrop wallet pubkey (the PUBKEY used for devnet E1 testing).
# This wallet holds worthless devnet SOL only. NOT the mainnet trade wallet.
# Get devnet SOL: solana airdrop 2 <pubkey> --url devnet
DEVNET_WALLET_PUBKEY=<devnet-wallet-pubkey>

# Devnet confirmation settings (tune for devnet's slower block times).
# Max number of getSignatureStatuses polls before timing out.
DEVNET_CONFIRM_MAX_POLLS=30
# Seconds between each poll.
DEVNET_CONFIRM_POLL_INTERVAL_S=0.5
# ============================================================
# END E1 BLOCK
# ============================================================

# ============================================================
# BEGIN E2 BLOCK — creator/token denylist + trusted allowlist pre-filter
# ============================================================
# E2 — the file-backed, hot-reloadable creator/token DENYLIST + trusted
# ALLOWLIST pre-filter (aats/risk/blacklist.py). Runs BEFORE the sub-10ms
# pre-trade safety gate. The denylist can ONLY REJECT (de-risk-only); the
# allowlist does NOT skip the safety gate. No secrets here — the referenced
# file holds PUBLIC on-chain addresses (creator wallets, token mints) only.

# Path to the denylist/allowlist JSON (relative to repo root or absolute).
# Default if unset: config/creator-token-denylist.json
CREATOR_TOKEN_DENYLIST_PATH=<path-to-denylist-json-e.g. config/creator-token-denylist.json>

# Throttle (seconds) for how often the SLOW-loop hot-reload tick may stat()
# the file. The FAST/snipe path NEVER reloads — it reads the frozen snapshot.
# Default if unset: 2.0
CREATOR_TOKEN_DENYLIST_RELOAD_THROTTLE_S=<seconds-e.g. 2.0>

# Reminder: real capital stays DISABLED behind DRY-RUN regardless of this
# filter. The denylist adds selectivity (more rejects); it never enables a buy
# and never lifts the DRY-RUN / mainnet hard-gate.
# ============================================================
# END E2 BLOCK
# ============================================================

# ============================================================
# BEGIN E8 BLOCK — tunable discovery/screener filter (survivor niche)
# ============================================================
# E8 — the SLOW-LOOP discovery/SCREENER filter (aats/risk/screener.py) for the
# late-entry / survivor niche. It runs OFF the FAST/snipe hot path, over the
# already-fetched discovery enrichment (DEXScreener/Birdeye, T-301), and surfaces
# structured CANDIDATE REASONS. It is SELECTIVITY / DE-RISK ONLY: it can only
# REJECT/exclude an out-of-band candidate or pass it through to the EXISTING
# safety gate + classifier + asymmetric-trust pipeline. A screen PASS is NEVER a
# standalone buy trigger. No secrets here — these are tuning thresholds only.

# Market-cap band (USD). Below MIN => too-early/illiquid; above MAX => already-run.
# Defaults if unset: 70000 .. 11000000.
SCREENER_MCAP_MIN_USD=<usd-e.g. 70000>
SCREENER_MCAP_MAX_USD=<usd-e.g. 11000000>

# Minimum liquidity (USD). Below this there is no realistic exit => exclude.
# Default if unset: 20000.
SCREENER_MIN_LIQUIDITY_USD=<usd-e.g. 20000>

# Minimum 24h-volume-to-mcap turnover ratio (fraction in [0,1]). Dead/low-turnover
# tokens below this are excluded. Default if unset: 0.10 (i.e. >=10%).
SCREENER_MIN_VOLUME_TO_MCAP_RATIO=<fraction-e.g. 0.10>

# Volume-spike multiplier: 24h volume >= this * baseline tags VOLUME_SPIKE. This is
# a CONTRARIAN-AWARE INFO tag for the SLOW-loop reasoner, NEVER a buy trigger.
# Default if unset: 3.
SCREENER_VOLUME_SPIKE_MULTIPLIER=<multiplier-e.g. 3>

# Freshness budget (ms): enrichment bundles older than this are EXCLUDED
# refuse-by-default (we never pass on stale discovery data). Default if unset: 60000.
SCREENER_MAX_STALENESS_MS=<ms-e.g. 60000>

# Reminder: tightening any threshold only EXCLUDES MORE (always safe). This filter
# adds selectivity; it never enables a buy and never lifts the DRY-RUN / mainnet
# hard-gate. The safety primitives (breaker / survivable-stop / DMS) are untouched
# and still fire.
# ============================================================
# END E8 BLOCK
# ============================================================

# ============================================================
# BEGIN E13 BLOCK — anti-FOMO / already-pumped exclusion filter
# ============================================================
# E13 — the SLOW-LOOP anti-FOMO / already-pumped EXCLUSION filter
# (aats/risk/anti_fomo.py). It runs OFF the FAST/snipe hot path, point-in-time over
# already-fetched price/pump history + mainstream-mention labels, and surfaces
# structured CANDIDATE REJECT REASONS. It is SELECTIVITY / DE-RISK ONLY: it can only
# REJECT (already ran / hard mainstream mention), DOWN-WEIGHT conviction (warm pump /
# soft mention), or pass through UNCHANGED to the EXISTING pipeline. Its conviction
# multiplier is clamped to <= 1, so it can NEVER size anything up. A mainstream /
# CEX-listing / Forbes-tier mention is an EXCLUSION signal, NEVER a buy trigger.
# No secrets here — these are tuning thresholds only.

# HARD pump ceiling: ratio of current price to the window-anchor price. A run-up at or
# above this is a REJECT (already pumped). Default 4.0 = +300% (the >300% directive).
# Lowering this (tightening) only EXCLUDES MORE — always safe.
ANTI_FOMO_HARD_PUMP_RATIO=<ratio-e.g. 4.0>

# WARM pump floor (ratio). Run-up in [WARM, HARD) is DOWN-WEIGHTED (conviction haircut),
# not rejected. Must be >= 1.0 and <= HARD. Default 2.0 = +100% (already doubled).
ANTI_FOMO_WARM_PUMP_RATIO=<ratio-e.g. 2.0>

# Maximum conviction HAIRCUT at the top of the warm band (fraction in [0,1]); the
# haircut scales linearly from 0 at the warm floor to this just below the hard ceiling.
# Default 0.50 => at worst the warm band halves conviction. DE-RISK multiplier only.
ANTI_FOMO_MAX_WARM_PUMP_HAIRCUT=<fraction-e.g. 0.50>

# Conviction MULTIPLIER for a SOFT mainstream mention (minor CEX / mainstream
# influencer), fraction in [0,1]. Default 0.50 => a soft mention halves conviction.
ANTI_FOMO_SOFT_MENTION_MULTIPLIER=<fraction-e.g. 0.50>

# Freshness budget (ms): pump/mention bundles older than this are EXCLUDED
# refuse-by-default (we never pass an "un-pumped" verdict on stale price history).
# Default if unset: 60000.
ANTI_FOMO_MAX_STALENESS_MS=<ms-e.g. 60000>

# Minimum price samples required to form a run-up ratio. Fewer => NO_PUMP_HISTORY (no
# opinion, NOT an exclusion — a brand-new token legitimately has no run-up). Min 2.
ANTI_FOMO_MIN_PRICE_SAMPLES=<count-e.g. 2>

# Reminder: every knob here is DE-RISK / SELECTIVITY ONLY. This filter never enables a
# buy, never lifts the DRY-RUN / mainnet hard-gate, and never raises conviction or
# size. The safety primitives (breaker / survivable-stop / DMS) are untouched and
# still fire. A mainstream/CEX/Forbes mention is a SELL-into-retail signal here.
# ============================================================
# END E13 BLOCK
# ============================================================

# ============================================================
# AUDIT-micropreset BLOCK — the EARLY-ENTRY *MICRO* preset (a NAMED composition)
# ============================================================
# The MICRO preset (aats/risk/presets.py) is a NAMED, frozen composition of the
# ALREADY-BUILT risk primitives:
#   verified + LP locked/burned >= 30d + honeypot (sellability) PASS
#   + top-5 holders < 20% + 0.5% sizing (hard-clamped by per-trade & aggregate
#   caps) + (18% survivable hard stop OR 24h event-time time-exit).
#
# Its constraints are HARDCODED, TIGHTEN-ONLY DE-RISK constants by design — they
# are NOT env-tunable, because a safety preset must not be loosenable from the
# environment. There are therefore NO secrets and NO knobs to set here; this block
# is documentation so an operator knows the named preset exists and is selectable
# via aats.risk.presets.entry_preset("micro").
#
# Reminder: selecting MICRO is SELECTIVITY / DE-RISK ONLY. It can only REJECT a
# candidate, SHRINK a size (never above the existing caps), or EXIT a position. It
# never enables a buy, never lifts the DRY-RUN / mainnet hard-gate, never widens a
# stop, and never raises size or conviction. The safety primitives (daily-loss
# circuit breaker / survivable stop / dead-man's switch) are UNTOUCHED and still
# fire. Social/news/screener/caller signals are NOT part of the MICRO entry
# decision (they are SLOW-loop only).
# ============================================================
# END AUDIT-micropreset BLOCK
# ============================================================

# ============================================================
# E6 BLOCK — Discord ingestion adapter (SLOW-LOOP, de-risk/selectivity only)
# ============================================================
# Discord Bot token for the AATS MCS sentiment ingestion adapter.
# MANDATORY: this MUST be a Bot application token from the Discord Developer
# Portal (https://discord.com/developers/applications).  Self-bot tokens
# (user account tokens) are FORBIDDEN — they violate Discord ToS and are
# structurally rejected by the DiscordAdapter (no user_token parameter).
#
# HOW TO OBTAIN: register an Application in the Discord Developer Portal,
# add a Bot to it, copy the Bot token from the Bot settings page.
# The bot must be invited (OAuth2) to each server on the ALLOWLIST with
# the "Read Messages" and "Read Message History" scopes — no other permissions
# are needed or granted.
#
# NEVER COMMIT THE REAL TOKEN.  Inject it at deploy time via environment or
# Vault (VAULT_ADDR / WALLET_SECRET_VAULT_PATH pattern — see §Vault above).
DISCORD_BOT_TOKEN=<discord-bot-application-token>

# Allowlist of (guild_id, channel_id) pairs the bot is authorised to read.
# Format: JSON array of [guild_id, channel_id] integer pairs.
# Example (replace with real server/channel IDs at deploy time):
#   DISCORD_CHANNEL_ALLOWLIST=[[1234567890123456789, 9876543210987654321]]
# The bot will ONLY fetch messages from channels explicitly listed here.
# It does NOT crawl, does NOT enumerate servers, and does NOT join channels
# that are not in this allowlist.
DISCORD_CHANNEL_ALLOWLIST=<json-array-of-guild-channel-pairs>

# Maximum number of messages fetched per channel per cadence cycle.
# Keep this low to stay within the Discord rate limits (50 req/s global).
# Default: 100  (matches DiscordAdapter.max_messages_per_channel default).
DISCORD_MAX_MESSAGES_PER_CHANNEL=100

# Reminder: the Discord adapter is SLOW-LOOP ONLY.  It feeds the Tier-A
# CryptoBERT filter -> MCS pipeline.  Coordinated/low-account-age/synchronized
# Discord hype LOWERS conviction — it is NEVER a standalone buy trigger and
# NEVER raises risk.  Safety primitives (breaker / survivable-stop / DMS)
# are UNTOUCHED.  All social/news/caller signals are DE-RISK / SELECTIVITY ONLY.
# Real capital remains DRY-RUN-disabled until CEO R3 authorisation.
# ============================================================
# END E6 BLOCK
# ============================================================

# ============================================================
# E7 BLOCK — News / breaking-news layer (SLOW-LOOP, de-risk/selectivity only)
# ============================================================
# News signals feed the MCS pipeline as a CONTRIBUTOR and as a
# narrative-failure input.  A credible NEGATIVE article (TIER_1 or TIER_2
# outlet) can trigger a FORCE_EXIT (de-risk only) via the Reasoner's
# narrative_failure hook.
#
# HARD RULES (non-waivable):
#   - News signals are SLOW-LOOP ONLY — never on the SNIPE hot path.
#   - A credible NEGATIVE event LOWERS MCS conviction (mcs_delta <= 0.0).
#   - Positive / neutral news has ZERO effect on MCS (never raises conviction).
#   - A Forbes/Bloomberg "mainstream adoption" headline is a SELL-into-retail
#     signal (alpha is gone by that point) — it does NOT raise conviction.
#   - The news narrative_failure hook can ONLY force FORCE_EXIT (de-risk).
#     It can NEVER size up, widen a stop, add leverage, or override a hard stop.
#   - All ingested text (headlines, summaries) is QUOTED UNTRUSTED DATA.
#   - Safety primitives (breaker / survivable-stop / DMS) are UNTOUCHED.
#   - Real capital remains DRY-RUN-disabled until CEO R3 authorisation.
#
# CREDENTIALS: NEVER commit real values.  Inject at deploy time via environment
# or Vault (VAULT_ADDR / WALLET_SECRET_VAULT_PATH pattern — see §Vault above).
# Offline / CI operation: leave all values as the <placeholder> defaults.
# The RSSNewsAdapter returns [] when no feeds are configured (safe default).
#
# ---- RSS Feed URLs (one per supported outlet) ----
# Leave as <placeholder> for offline/CI.  Inject real RSS URLs at deploy time.
# CoinDesk RSS (Tier-1 crypto-native flagship):
NEWS_RSS_COINDESK_URL=<coindesk-rss-feed-url>
# The Block RSS (Tier-1 crypto-native flagship):
NEWS_RSS_THEBLOCK_URL=<theblock-rss-feed-url>
# Cointelegraph RSS (Tier-1 crypto-native flagship):
NEWS_RSS_COINTELEGRAPH_URL=<cointelegraph-rss-feed-url>
# Forbes Crypto RSS (Tier-2 mainstream crypto-adjacent — mainstream mention is
# a SELL signal, NOT a buy; Forbes coverage = retail exit liquidity):
NEWS_RSS_FORBES_URL=<forbes-crypto-rss-feed-url>
# Bloomberg Crypto RSS (Tier-2 mainstream crypto-adjacent):
NEWS_RSS_BLOOMBERG_URL=<bloomberg-crypto-rss-feed-url>
# Reuters RSS (Tier-2 mainstream):
NEWS_RSS_REUTERS_URL=<reuters-rss-feed-url>

# ---- Optional NewsAPI.org key (supplemental coverage) ----
# Free tier: 100 requests/day.  Leave blank to disable NewsAPI entirely.
# HOW TO OBTAIN: register at https://newsapi.org/ (free plan available).
# The key is inject-only — NEVER commit the real value.
NEWS_API_KEY=<newsapi-org-api-key>

# ---- Lookback window for news ingestion ----
# How far back to look for breaking news articles (milliseconds).
# Default: 86400000 (24 hours).  Can be tightened for high-cadence operation.
NEWS_LOOKBACK_WINDOW_MS=86400000

# ---- Breaking-news sensitivity ----
# Credibility tier required to trigger narrative_failure (FORCE_EXIT).
# Default: tier_1_or_tier_2 (both TIER_1 and TIER_2 outlets qualify).
# Tighten to tier_1_only for higher false-positive resistance.
NEWS_CREDIBLE_NEGATIVE_THRESHOLD=tier_1_or_tier_2

# Reminder: the news adapter is SLOW-LOOP ONLY.  It feeds the MCS pipeline
# as a CONTRIBUTOR (lowers conviction) and as a narrative-failure input to
# the Reasoner (FORCE_EXIT de-risk only).  It is NEVER on the SNIPE hot path,
# NEVER a standalone buy trigger, and NEVER raises risk.
# ============================================================
# END E7 BLOCK
# ============================================================

# ============================================================
# BEGIN E9 BLOCK — Alpha-caller / call-channel track-record scoring
# ============================================================
# E9 — the SLOW-LOOP alpha-caller TRACK-RECORD SCORER
# (aats/sentiment/caller_score.py).
#
# HOW IT WORKS:
#   Named callers (Discord alpha channels, Telegram signal groups, X accounts)
#   are tracked by a stable caller_id.  Each caller is scored by HISTORICAL
#   accuracy on RECORDED on-chain outcomes (joined by event_time, leak-free).
#   The output is a WEIGHTED SELECTIVITY MODIFIER in [0.0, 1.0]:
#     - 0.0 = net-negative caller (completely deweighted, de-risk)
#     - 1.0 = no caller data or neutral (no effect on conviction)
#   This modifier is applied to the MCS conviction as a DOWNWARD adjustment only.
#
# HARD RULES (non-waivable):
#   - Caller signal is SLOW-LOOP ONLY — never on the SNIPE/FAST hot path.
#   - The caller selectivity modifier CANNOT raise conviction above the social
#     base.  caller_selectivity_modifier in [0.0, 1.0] — never > 1.0.
#   - mcs_delta_contribution <= 0.0 always (can only de-risk).
#   - Most callers score near-zero or NEGATIVE; surface honestly, no inflation.
#   - No win_rate field, target, or computation anywhere in E9.
#   - The outcome store is INJECTED (not fetched live inside scorer).
#     In tests: InMemoryCallerOutcomeStore.
#     In production: ParquetCallerOutcomeStore (reads from the labels/ harness).
#   - Point-in-time: only outcomes with outcome_event_time_ms <= decision_time_ms
#     are used.  Future outcomes are excluded by construction.
#   - A caller with < MIN_CALLS_FOR_SCORE resolved outcomes is ignored (thin data).
#   - Outcome record storage (labels/ Parquet) is populated by the CLEAN-ROOM
#     HARNESS (T-401 / backtest-qa-engineer), NOT by this module.
#   - Caller signals are NEVER a standalone buy trigger.
#   - Safety primitives (breaker / survivable-stop / DMS) are UNTOUCHED.
#   - Real capital remains DRY-RUN-disabled until CEO R3 authorisation.
#
# CONFIGURATION (all optional; sane defaults if unset):
#
# Minimum number of resolved calls before we assign any non-zero weight.
# Below this threshold the caller is "thin data" (weight=0.0).
# Default: 3.  Raise to increase skepticism of low-history callers.
CALLER_MIN_CALLS_FOR_SCORE=<int-e.g. 3>
#
# Recency half-life for exponential decay of older outcomes (milliseconds).
# Outcomes older than ~2 half-lives get near-zero weight.
# Default: 604800000 (7 days = 1 week).
CALLER_RECENCY_HALF_LIFE_MS=<ms-e.g. 604800000>
#
# Universe baseline accuracy (float in [0,1]).
# The caller accuracy delta is computed relative to this prior.
# Default: 0.40 (most callers are wrong most of the time).
# Lower = more generous (easier to be "above average"); raise to be more skeptical.
CALLER_UNIVERSE_ACCURACY=<float-e.g. 0.40>
#
# Accuracy delta threshold (vs universe) below which a caller is flagged
# as net-negative and deweighted to 0.0.
# Default: -0.05 (5% below universe average => ignored).
CALLER_NEGATIVE_DELTA_THRESHOLD=<float-e.g. -0.05>
#
# Path to the Parquet labels dataset written by the clean-room harness (T-401).
# This is the ONLY data source for caller outcome records.
# If unset or the file is absent, the scorer falls back to the empty
# InMemoryCallerOutcomeStore (no caller signal, all weights neutral).
# NEVER points to a live on-chain or network endpoint.
CALLER_OUTCOME_STORE_PATH=<path-to-labels-parquet-e.g. data/labels/caller_outcomes>
#
# Reminder: caller signals feed into the MCS pipeline as a DOWNWARD modifier
# only.  They are SLOW-LOOP ONLY, NEVER a buy trigger, NEVER raise risk,
# NEVER raise conviction.  The selectivity modifier is AT MOST 1.0 (neutral).
# ============================================================
# END E9 BLOCK
# ============================================================

# ============================================================
# BEGIN E10 BLOCK — Social-velocity + organic-vs-bot growth ratio (SLOW-LOOP, de-risk only)
# ============================================================
# E10 — the SLOW-LOOP social-velocity and organic/bot-growth-ratio scorer
# (aats/sentiment/velocity.py).
#
# HOW IT WORKS:
#   Computes three adversarial growth signals for a rolling window of social
#   events, each feeding a de-risk penalty:
#     1. Engagement VELOCITY: posts/minute from bot-scored accounts vs. organic
#        accounts.  A burst of bot-driven posts → velocity penalty.
#     2. Organic-vs-BOT growth ratio: fraction of unique posting accounts that
#        are bot-scored.  Bot-dominant growth → growth-ratio penalty.
#     3. Unique-holder growth rate (factory-account cohort): accounts whose
#        creation dates cluster within a 1-day window → factory-batch signal.
#        Bot farms deploy accounts in batches → cohort penalty.
#   The combined penalty (mcs_penalty in [0.0, 1.0]) is SUBTRACTED from the
#   social MCS conviction.  Coordinated / bot-driven growth lowers conviction.
#
# HARD RULES (non-waivable):
#   - Signal is SLOW-LOOP ONLY — never on the SNIPE/FAST hot path.
#   - mcs_penalty >= 0.0 always — can ONLY lower conviction, never raise it.
#   - Bot-driven growth raises the penalty (de-risk direction).
#   - Organic growth has zero upward effect on MCS conviction.
#   - The signal is NEVER a standalone buy trigger.
#   - No win_rate field, target, or computation anywhere in E10.
#   - All external services NOT reachable inside this module — injectable
#     VelocitySource Protocol; tests use InMemoryVelocitySource.
#   - Point-in-time: only events with event_time_ms <= decision_time_ms are
#     included.  Enforced as the FIRST filter inside compute().
#   - Safety primitives (breaker / survivable-stop / DMS) are UNTOUCHED.
#   - Real capital remains DRY-RUN-disabled until CEO R3 authorisation.
#
# CONFIGURATION (all optional; sane defaults if unset):
#
# Rolling window for velocity computation (milliseconds).
# Posts outside this window AND before decision_time_ms are excluded.
# Default: 900000 (15 minutes).
VELOCITY_WINDOW_MS=<ms-e.g. 900000>
#
# Account-age threshold below which an account is treated as "bot-likely"
# for velocity purposes (days).  Consistent with Tier-A BOT_AGE_THRESHOLD_DAYS.
# Default: 7.0 (< 1 week = young account = suspicious).
VELOCITY_BOT_AGE_THRESHOLD_DAYS=<float-e.g. 7.0>
#
# Bot-account fraction above which the growth_ratio penalty is maximised.
# Default: 0.70 (70% of posting accounts are bots → full GROWTH_RATIO_WEIGHT).
VELOCITY_BOT_FRACTION_FULL_PENALTY=<float-e.g. 0.70>
#
# Factory-account cohort detection window (seconds).
# Accounts whose creation dates cluster within this window of each other are
# treated as a factory-batch (bot farm deploys).
# Default: 86400 (1 day).
VELOCITY_COHORT_WINDOW_S=<seconds-e.g. 86400>
#
# Fraction of unique posting accounts that must fall in the same cohort window
# to trigger the factory-account cohort flag.
# Default: 0.50 (50% of accounts in the same cohort → flag raised).
VELOCITY_COHORT_THRESHOLD=<float-e.g. 0.50>
#
# Penalty weight for the bot-velocity component (fraction of total penalty).
# Default: 0.45.  Higher = more sensitive to bot velocity bursts.
VELOCITY_BOT_VELOCITY_WEIGHT=<float-e.g. 0.45>
#
# Penalty weight for the organic-vs-bot growth ratio component.
# Default: 0.35.  Higher = more sensitive to bot-dominant account growth.
VELOCITY_GROWTH_RATIO_WEIGHT=<float-e.g. 0.35>
#
# Penalty weight for the factory-account holder-growth component.
# Default: 0.20.  Higher = more sensitive to cohort-batch account creation.
VELOCITY_HOLDER_GROWTH_WEIGHT=<float-e.g. 0.20>
#
# Reminder: velocity signals feed into MCS as a DOWNWARD modifier only.
# They are SLOW-LOOP ONLY, NEVER a buy trigger, NEVER raise risk,
# NEVER raise conviction.  The mcs_penalty is clamped to [0.0, 1.0].
# ============================================================
# END E10 BLOCK
# ============================================================
